DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://ris_user:change-me@postgres:5432/ris_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
DEFAULT_FROM_EMAIL=noreply@ris.local
DJANGO_LANGUAGE=en
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# ─── PACS (Phase 1 — Orthanc archive; docs/PACS_IMPLEMENTATION.md) ──────────
# DICOM Storage SCP listener (separate from the RIS_SCP MWL server on 11112).
ORTHANC_NAME=PulsaRIS-PACS
ORTHANC_AE_TITLE=PULSAR_PACS
ORTHANC_DICOM_PORT=4242
ORTHANC_REST_PORT=8042
# Host interface the DICOM port is published on. Keep 127.0.0.1 until the
# LAN/VPN firewall review; set to the medical-network interface IP for devices.
ORTHANC_DICOM_BIND_IP=127.0.0.1
# Service-to-service REST credentials — generate strong random values, store
# in your secrets manager. NEVER commit real values.
ORTHANC_RIS_USER=ris-sync
ORTHANC_RIS_PASSWORD=change-me-strong-random
ORTHANC_ADMIN_USER=pacs-admin
ORTHANC_ADMIN_PASSWORD=change-me-strong-random
# Approved senders: comma-separated "AE-TITLE:IPv4" pairs built from the
# core.Device records (dicom_ae_title + dicom_host). Empty = reject everyone.
# Example: ORTHANC_ALLOWED_SENDERS=CT_01:10.20.0.11,MR_01:10.20.0.12
ORTHANC_ALLOWED_SENDERS=
# Bounded-operation limits (tune after representative tests, plan Task 1.2).
ORTHANC_MAX_CONCURRENT_CONNECTIONS=16
ORTHANC_LIMIT_QUERIES=512
ORTHANC_LIMIT_METADATA_BYTES=16777216
# Django-side Orthanc client base URL (internal Docker network only).
ORTHANC_API_URL=http://orthanc:8042
