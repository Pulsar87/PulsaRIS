// ─────────────────────────────────────────────────────────────────────────────
// Orthanc PACS archive — SAMPLE configuration (documentation only).
//
// This file is NOT mounted by docker-compose. The `orthanc` service generates
// its effective configuration at container start from ORTHANC_* environment
// variables (see docker-compose.yml), so that AE titles, ports, credentials
// and the modality allowlist stay in one place: .env / secrets, never Git.
//
// A rendered copy of the real config appears at runtime under
// ${ORTHANC_CONFIG_DIR}/orthanc-sample-rendered.json on that volume.
// Copy this shape when writing a permission-restricted mounted config for
// production, or set RUNTIME_CONFIG=0 and mount a file at /etc/orthanc/.
// Replace every <...> placeholder; supply secrets via the environment.
// ─────────────────────────────────────────────────────────────────────────────
{
  "Name": "PulsaRIS-PACS",

  // DICOM Storage SCP listener — dedicated PACS AE title, separate from the
  // PulsaRIS MWL SCP (RIS_SCP on 11112). Port published only to the LAN/VPN
  // interface by default; REST below stays internal-only.
  "DicomAet": "PULSAR_PACS",
  "DicomPort": 4242,

  // Orthanc's own integrity checks are enabled; silent overwrite of an
  // existing SOP Instance with *different* content is refused (plan Task 1.2:
  // conflicting retransmissions must surface, never overwrite).
  "CheckIncomingIntegrity": true,
  "VerifyIncomingDigestions": true,

  // Network isolation (plan Tasks 1.1/1.3): REST/DICOMweb reachable ONLY from
  // the private Docker network (and localhost inside the container). No host
  // port mapping for 8042 in compose. TLS should terminate at a reviewed
  // reverse-proxy boundary if REST is ever exposed beyond the service network.
  "RemoteAccessAllowed": true,
  "SSLEnabled": false,
  "AuthenticationEnabled": true,
  "RegisteredUsers": {
    "<orthanc-ris-service-user>": "<strong-random-secret-from-secrets-store>",
    "<orthanc-admin-user>": "<strong-random-secret-stored-outside-git>"
  },

  // Hardening (plan Task 1.3): Lua scripting disabled — no remote script
  // execution as a convenience.
  "LuaScripts": [],

  // Bounded operations (plan Tasks 1.2/1.3): limit concurrent associations,
  // query results, and per-request sizes based on representative tests.
  "MaxConcurrentConnections": 16,
  "LimitQueries": 512,
  "LimitMetadata": 16777216,
  "LimitRepliesPerInstQuery": 512,

  // Accepted transfer syntaxes: initial set = uncompressed + the JPEG family
  // commonly emitted by modalities. EXTEND ONLY after validating each device's
  // conformance statement against this exact image/plugin combination
  // (plan Task 1.2: do not claim support without testing). Add e.g.
  // "Jpeg2000Lossless" here once tested end-to-end.
  "AcceptedTransferSyntaxes": [
    "1.2.840.10008.1.2",
    "1.2.840.10008.1.2.1",
    "1.2.840.10008.1.2.4.50",
    "1.2.840.10008.1.2.4.51",
    "1.2.840.10008.1.2.4.70"
  ],

  // Plugin activation. The orthancteam/orthanc image preinstalls plugins under
  // /usr/share/orthanc/plugins; defining DicomWeb.Enable activates the plugin.
  // DICOMweb remains private to the service network: REST has no host mapping,
  // and browser traffic must pass through the audited Django proxy.
  "Plugins": ["/usr/share/orthanc/plugins/"],
  "DicomWeb": {
    "Enable": true,
    "Root": "/dicom-web/"
  },
  "EnableOnlineDeployment": false,

  // Object storage path (persistent named volume `orthanc-db` in compose).
  "StorageDirectory": "/var/lib/orthanc/db",
  "IndexDirectory": "/var/lib/orthanc/db"
}
